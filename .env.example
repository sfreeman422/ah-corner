# Local host scripts may leave DATABASE_URL blank and use ./data. Docker deployment requires it.
MODE=demo
# Set true for hosted deployments. Requires the Muzzle Slack exchange endpoint.
REQUIRE_AUTH=false
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Existing MySQL or MariaDB server. From Docker on the same machine, host.docker.internal is available.
# Percent-encode reserved characters in the username or password.
# Example: mysql://ahcorner_runtime:encoded-password@host.docker.internal:3306/ahcorner
DATABASE_URL=
# Optional privileged URL used only by `npm run migrate`; otherwise DATABASE_URL is used.
DATABASE_MIGRATION_URL=
# Choose deliberately: disable for a private local network, verify-full for TLS MySQL/MariaDB.
DATABASE_SSL=disable
REQUIRE_DATABASE_SSL=false
# Optional PEM CA file mounted inside the container when DATABASE_SSL=verify-full.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=3
DATABASE_QUEUE_LIMIT=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=15000
DATABASE_APPLICATION_NAME=ah-corner

# Compose binds the application to loopback by default; use a TLS reverse proxy for public access.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
# Exact public Host header(s) and browser Origin(s), comma-separated. Update before hosting.
APP_TRUSTED_HOSTS=localhost:3000,127.0.0.1:3000
APP_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
REGION=us
RULESET_ID=1
# REQUIRED in live mode, after comparing two in-game items with discovery output.
HOUSE_ID=
HOUSE_VERIFIED=false
POLL_MINUTES=15
BANKROLL_GOLD=35
MAX_EXPOSURE=0.35
MIN_ROI=0.30
AH_FEE=0.05
MIN_HISTORY=6
# Optional, for real opportunities only. Keep private.
ALERT_WEBHOOK_URL=
